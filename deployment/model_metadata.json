{
    "project": "EdgeAI-Arm-Optimization",
    "architecture": "MobileNetV3",
    "dataset": "Fashion-MNIST",
    "model_format": "ONNX",
    "quantization": "Static INT8",
    "input_preprocessing": {
        "resize": [
            96,
            96
        ],
        "channels": 3,
        "normalization_mean": [
            0.5,
            0.5,
            0.5
        ],
        "normalization_std": [
            0.5,
            0.5,
            0.5
        ]
    },
    "inputs": [
        {
            "name": "input",
            "shape": [
                1,
                3,
                96,
                96
            ],
            "type": "tensor(float)"
        }
    ],
    "outputs": [
        {
            "name": "output",
            "shape": [
                1,
                10
            ],
            "type": "tensor(float)"
        }
    ],
    "class_names": [
        "T-shirt/top",
        "Trouser",
        "Pullover",
        "Dress",
        "Coat",
        "Sandal",
        "Shirt",
        "Sneaker",
        "Bag",
        "Ankle boot"
    ],
    "target_platform": "ARM CPU",
    "validated_platform": "Windows CPU",
    "arm_hardware_tested": false
}